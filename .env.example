# SkillCast local environment — copy to .env.local and fill in.
# .env.local is gitignored; never commit real keys.

# SQLite database. A relative (or missing) value is pinned at startup
# (src/lib/db.ts) to the repository's db/custom.db — same in dev and the
# standalone build. Use an absolute path to point elsewhere.
DATABASE_URL=file:../db/custom.db

# ─── RunPod (optional — enables AI-assisted CV extraction) ─────────────────
# Without a key the app still works: onboarding falls back to deterministic
# in-browser extraction. Get a key at:
#   https://console.runpod.io -> Settings -> API Keys -> Create (General Purpose)
# Or run `bun run setup:runpod` to fill these in interactively.
RUNPOD_API_KEY=
# Shared SkillCast endpoint (self-hosted Qwen2.5-7B-Instruct, EU-RO-1) —
# teammates reuse this id; do not deploy your own endpoint.
RUNPOD_ENDPOINT_ID=3sz0imio0udhna